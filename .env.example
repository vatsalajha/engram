# Alibaba Cloud DashScope (Qwen) — required
DASHSCOPE_API_KEY=sk-...
ENGRAM_QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Redis — OPTIONAL. Leave unset to use the in-process rate-limit/idempotency
# fallback; set to upgrade to Redis (or Alibaba Tair) for multi-instance runs.
# REDIS_URL=redis://localhost:6379

# SQLite database path
ENGRAM_DB_PATH=./data/engram.db

# Token budget for context packing (tokens)
ENGRAM_CONTEXT_BUDGET=1500

# Server
PORT=3000
NODE_ENV=development

# Optional: enable qwen-flash reranking (true/false)
ENGRAM_RERANK_ENABLED=true

# Sleep cycle: set to "on" to run it on a schedule between sessions
ENGRAM_SCHEDULER=off
# How often the sleep cycle runs (consolidate · decay · infer), minutes
ENGRAM_SLEEP_INTERVAL_MIN=10

# Read / retrieval path
ENGRAM_RRF_K=60
ENGRAM_RETRIEVE_LEG_K=20
ENGRAM_RERANK_SHORTLIST=16
ENGRAM_RERANK_MODEL=qwen-flash

# Write path
ENGRAM_EXTRACT_MODEL=qwen-plus
# Cosine similarity threshold for semantic dedup (0–1). Candidates within this
# similarity of an existing active memory are treated as duplicates and skipped.
ENGRAM_DEDUPE_THRESHOLD=0.95

# Scoring / utility function weights (should sum to 1.0) — confidence is
# a first-class term in v2 (SPEC §4.2)
ENGRAM_SCORE_W_REL=0.45
ENGRAM_SCORE_W_SAL=0.20
ENGRAM_SCORE_W_CON=0.15
ENGRAM_SCORE_W_REC=0.10
ENGRAM_SCORE_W_TYP=0.10
ENGRAM_RECENCY_LAMBDA=0.1

# Packer: fraction of the context budget reserved for pinned + preference/decision
ENGRAM_PACK_RESERVED_FRACTION=0.25

# Belief engine: confidence step per confirm/contradict, and the floor below
# which hypotheses auto-archive (facts/preferences get flagged for supersession)
ENGRAM_BELIEF_ETA=0.15
ENGRAM_CONFIDENCE_FLOOR=0.25

# Retention / forgetting weights (should sum to 1.0) — 4 terms (SPEC §4.5)
ENGRAM_RETENTION_W_SAL=0.35
ENGRAM_RETENTION_W_CON=0.25
ENGRAM_RETENTION_W_REC=0.25
ENGRAM_RETENTION_W_ACC=0.15

# Sleep cycle: forgetting
ENGRAM_ARCHIVE_THRESHOLD=0.3
ENGRAM_EXPIRE_ARCHIVED_HOURS=48

# Sleep cycle: consolidation
ENGRAM_CONSOLIDATE_MIN=3
ENGRAM_CONSOLIDATE_K=10
ENGRAM_CONSOLIDATE_SIM=0.82

# Sleep cycle: inference ("the agent dreams")
ENGRAM_INFER_MAX=3
ENGRAM_INFER_DEDUPE_SIM=0.9
ENGRAM_HYPOTHESIS_CONFIDENCE=0.4
ENGRAM_INFER_EPISODIC_N=40

# Rate limiting (per-user sliding window, via Redis)
ENGRAM_RATE_LIMIT_MAX=60
ENGRAM_RATE_LIMIT_WINDOW_SECONDS=60

# Idempotency key TTL (seconds); duplicates rejected within this window
ENGRAM_IDEMPOTENCY_TTL_SECONDS=86400
